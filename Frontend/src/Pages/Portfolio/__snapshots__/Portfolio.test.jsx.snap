exports[`Portfolio page snapshots renders full content when usePortfolioData returns data 1`] = `
<div>
  <div
    data-testid="bg"
  >
    <div
      class="w-[700px] m-[40px_auto] flex flex-col items-stretch min-h-[320px] rounded-2xl shadow-xl bg-white/60 backdrop-blur-md ring-1 ring-white/40"
      data-testid="portfolio-content-layout"
    >
      <div
        data-testid="header"
      >
        HeaderAntd 
        true
      </div>
      <div
        class="flex flex-1 min-h-[320px]"
      >
