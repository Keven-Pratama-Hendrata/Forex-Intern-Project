          class="w-[150px] min-h-[320px] bg-slate-200/85 rounded-bl-xl"
        >
          <div
            data-testid="sidebar"
          >
            Sidebar
          </div>
        </div>
        <main
          class="flex-1 flex justify-center items-center pl-1"
        >
          <div
            class="w-full p-6"
          >
            <div
              class="w-full"
            >
              <div
                class="mb-3"
              >
                <h3
                  class="text-base font-bold text-gray-800 mb-2"
                >
                  Portfolio Distribution (IDR)
                </h3>
                <p
                  class="text-sm font-semibold text-gray-600 mb-2"
                  data-testid="total-idr"
                >
                  Total Balance: Rp
                   
                  10.000,00
                </p>
              </div>
              <div
                class="h-64"
              >
                <div
                  data-testid="pie"
                >
                  PieChart
                </div>
              </div>
            </div>
          </div>
        </main>
      </div>
    </div>
  </div>
</div>
`;

